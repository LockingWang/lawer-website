# 後端環境變數（正式環境透過 GitHub Secrets → Google Cloud Run 注入；勿提交 .env）
# 本機開發：複製為 backend/.env 後填入

# 伺服器
PORT=3001

# CORS：允許的前端來源（逗號分隔），須含正式網域（例：https://www.example.com）
# 未設定時預設允許本機常見 Origin（僅開發）
CORS_ORIGINS=http://localhost:3000

# 選填：HTTPS 且 hostname 以此「後綴」結尾者一律允許（Cloudflare Pages 預覽網址用）
# 例：pages.dev,cloudflarepages.net — 僅 https；過寬時可留空改為只在 CORS_ORIGINS 逐筆列出
# CORS_ORIGIN_SUFFIXES=pages.dev,cloudflarepages.net

# 聯絡表單收件信箱（必填，除非僅用 MAIL_DRY_RUN）
CONTACT_TO_EMAIL=

# 本機／CI 驗證：設為 1 時不寄信，僅 console 記錄並回 200（與正式 SMTP 二擇一使用）
MAIL_DRY_RUN=1

# 寄件者（SMTP 用；未設則退回 SMTP_USER 或 CONTACT_TO_EMAIL）
SMTP_FROM=

# 寄信：SMTP（擇一；與 Resend 擇一）
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# 或交易型郵件 Resend（擇一；需儀表板已驗證之網域發信地址）
# RESEND_API_KEY=
# RESEND_FROM="無憂吳律 <onboarding@resend.dev>"

# Instagram Graph API — 限時動態代理（階段 10；權杖勿提交 Git）
# 專業帳戶之 Instagram Business Account ID（數字字串）
INSTAGRAM_IG_USER_ID=
# 長效 User 或 Page Access Token（須含 instagram_manage_insights 等 Graph 所需權限）
INSTAGRAM_ACCESS_TOKEN=
# 選填，預設 v19.0
# FACEBOOK_GRAPH_VERSION=v19.0

# Instagram Graph API（階段 10 應用程式識別，與上方權杖分開設定）
META_APP_ID=
META_APP_SECRET=
